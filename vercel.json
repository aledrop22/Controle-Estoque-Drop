{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/:path*"
        }
    ],
    "functions": {
        "api/**/*.js": {
            "maxDuration": 60
        }
    },
    "build": {
        "env": {
            "VITE_GEMINI_API_KEY": "@vite_gemini_api_key"
        }
    }
}